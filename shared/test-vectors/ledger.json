{
  "cases": [
    {
      "name": "empty",
      "maxBank": null,
      "entries": [],
      "expectedBalance": 0
    },
    {
      "name": "earn and spend",
      "maxBank": null,
      "entries": [
        {
          "id": "s1",
          "kind": "earn",
          "minutes": 100,
          "at": 1000
        },
        {
          "id": "p1",
          "kind": "spend",
          "minutes": 1,
          "at": 2000
        },
        {
          "id": "p2",
          "kind": "spend",
          "minutes": 1,
          "at": 3000
        }
      ],
      "expectedBalance": 98
    },
    {
      "name": "debit goes negative",
      "maxBank": null,
      "entries": [
        {
          "id": "p1",
          "kind": "spend",
          "minutes": 1,
          "at": 1000
        },
        {
          "id": "p2",
          "kind": "spend",
          "minutes": 1,
          "at": 2000
        }
      ],
      "expectedBalance": -2
    },
    {
      "name": "adjust signed",
      "maxBank": null,
      "entries": [
        {
          "id": "a1",
          "kind": "adjust",
          "minutes": 30,
          "at": 1000
        },
        {
          "id": "a2",
          "kind": "adjust",
          "minutes": -50,
          "at": 2000
        }
      ],
      "expectedBalance": -20
    },
    {
      "name": "max bank caps credit",
      "maxBank": 120,
      "entries": [
        {
          "id": "s1",
          "kind": "earn",
          "minutes": 100,
          "at": 1000
        },
        {
          "id": "s2",
          "kind": "earn",
          "minutes": 100,
          "at": 2000
        }
      ],
      "expectedBalance": 120
    },
    {
      "name": "max bank after spend",
      "maxBank": 120,
      "entries": [
        {
          "id": "s1",
          "kind": "earn",
          "minutes": 100,
          "at": 1000
        },
        {
          "id": "p1",
          "kind": "spend",
          "minutes": 50,
          "at": 2000
        },
        {
          "id": "s2",
          "kind": "earn",
          "minutes": 100,
          "at": 3000
        }
      ],
      "expectedBalance": 120
    },
    {
      "name": "earn exactly to cap",
      "maxBank": 60,
      "entries": [
        {
          "id": "s1",
          "kind": "earn",
          "minutes": 30,
          "at": 1000
        },
        {
          "id": "s2",
          "kind": "earn",
          "minutes": 30,
          "at": 2000
        },
        {
          "id": "s3",
          "kind": "earn",
          "minutes": 10,
          "at": 3000
        }
      ],
      "expectedBalance": 60
    },
    {
      "name": "max bank repays debit",
      "maxBank": 20,
      "entries": [
        {
          "id": "p1",
          "kind": "spend",
          "minutes": 40,
          "at": 1000
        },
        {
          "id": "s1",
          "kind": "earn",
          "minutes": 100,
          "at": 2000
        }
      ],
      "expectedBalance": 20
    },
    {
      "name": "order independent input",
      "maxBank": 100,
      "entries": [
        {
          "id": "s2",
          "kind": "earn",
          "minutes": 90,
          "at": 3000
        },
        {
          "id": "p1",
          "kind": "spend",
          "minutes": 60,
          "at": 2000
        },
        {
          "id": "s1",
          "kind": "earn",
          "minutes": 90,
          "at": 1000
        }
      ],
      "expectedBalance": 100
    },
    {
      "name": "same timestamp kind order",
      "maxBank": 100,
      "entries": [
        {
          "id": "p",
          "kind": "spend",
          "minutes": 50,
          "at": 1000
        },
        {
          "id": "e",
          "kind": "earn",
          "minutes": 100,
          "at": 1000
        },
        {
          "id": "a",
          "kind": "adjust",
          "minutes": 20,
          "at": 1000
        }
      ],
      "expectedBalance": 50
    },
    {
      "name": "duplicate ids count once",
      "maxBank": null,
      "entries": [
        {
          "id": "s1",
          "kind": "earn",
          "minutes": 100,
          "at": 1000
        },
        {
          "id": "s1",
          "kind": "earn",
          "minutes": 100,
          "at": 1000
        },
        {
          "id": "p1",
          "kind": "spend",
          "minutes": 1,
          "at": 2000
        }
      ],
      "expectedBalance": 99
    },
    {
      "name": "positive adjust capped",
      "maxBank": 60,
      "entries": [
        {
          "id": "s1",
          "kind": "earn",
          "minutes": 50,
          "at": 1000
        },
        {
          "id": "a1",
          "kind": "adjust",
          "minutes": 30,
          "at": 2000
        }
      ],
      "expectedBalance": 60
    },
    {
      "name": "negative adjust below zero",
      "maxBank": 60,
      "entries": [
        {
          "id": "a1",
          "kind": "adjust",
          "minutes": -10,
          "at": 1000
        },
        {
          "id": "s1",
          "kind": "earn",
          "minutes": 100,
          "at": 2000
        }
      ],
      "expectedBalance": 60
    }
  ]
}
