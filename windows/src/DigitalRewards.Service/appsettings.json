{
  "CloudKit": {
    "ContainerId": "iCloud.com.digitalrewards.app",
    "Environment": "development",
    "ApiToken": "REPLACE_WITH_CLOUDKIT_API_TOKEN"
  },
  "Enforcer": {
    "OfflineLimitHours": 24,
    "SyncIntervalSeconds": 30,
    "HeartbeatMinutes": 5,
    "VerifyAgentPath": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "EventLog": {
      "SourceName": "DigitalRewards",
      "LogLevel": {
        "Default": "Information"
      }
    }
  }
}
